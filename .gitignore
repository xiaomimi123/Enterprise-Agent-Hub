# 密钥与本地配置
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# 运行数据（Docker 卷、日志、生成结果）
data/
logs/
*.log
outputs/

# Obsidian 个人工作区状态
.obsidian/workspace*.json
.obsidian/cache

# 系统
.DS_Store

# RAGFlow 官方部署文件（由 hub/ragflow/setup.sh 拉取）
hub/ragflow/upstream/

# Node / 前端构建产物
node_modules/
dist/

# 设计讨论用的临时稿（superpowers 头脑风暴）
.superpowers/

# 应用发布物（zip 与 app.json 只在部署机上，不入库）
apps/*/

# 底座包构建产物（tools/build-bundle 生成，只在部署机上）
bundle/

# 接入器灰度发布（只在部署机上，见 tools/release-agent.py）
agent/rollout.json
agent/releases/
