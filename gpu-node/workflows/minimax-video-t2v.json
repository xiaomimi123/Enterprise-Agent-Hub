{
  "_meta": {
    "name": "短视频（MiniMax H3 文生视频 T2V）",
    "description": "文生视频，768×1344 竖版，107 帧 @24fps（约 4.5 秒），含音频，无需参考图。{{prompt}} {{seed}} {{timeline_data}} 由中枢派发时替换；total_frames 必须是 17k+5 网格，分辨率必须是 32 的倍数",
    "kind": "video",
    "wait_seconds": 900,
    "outputs": [
      "7"
    ]
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "5": {
    "class_type": "MiniMaxH3Director",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "video_vae": [
        "3",
        0
      ],
      "audio_vae": [
        "4",
        0
      ],
      "clip": [
        "2",
        0
      ],
      "task_type": "t2v — 文生视频(Text to Video)",
      "bd_grp_sample": "采样设置",
      "global_prompt": "{{prompt}}",
      "frame_rate": 24.0,
      "width": 768,
      "height": 1344,
      "ref_max_size": 768,
      "total_frames": 107,
      "timeline_data": "{{timeline_data}}",
      "steps": 25,
      "sampler": "res_multistep",
      "scheduler": "simple",
      "cfg": 1.0,
      "seed": "{{seed}}",
      "shift_video": 12.0,
      "shift_audio": 3.0,
      "clear_vram_between_segments": true,
      "export_source_images": false
    }
  },
  "6": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "5",
        0
      ],
      "fps": [
        "5",
        2
      ],
      "audio": [
        "5",
        1
      ],
      "bit_depth": 8
    }
  },
  "7": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "6",
        0
      ],
      "filename_prefix": "video/out",
      "format": "auto",
      "codec": "auto"
    }
  }
}