{
  "_meta": {
    "name": "小红书封面",
    "description": "文生图，3:4 竖版，一次出 3 张。{{prompt}} {{negative}} {{seed}} {{checkpoint}} 由中枢在派发时替换",
    "outputs": ["9"]
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "cfg": 7, "denoise": 1, "sampler_name": "euler", "scheduler": "normal", "steps": 25,
      "seed": "{{seed}}",
      "latent_image": ["5", 0], "model": ["4", 0], "negative": ["7", 0], "positive": ["6", 0]
    }
  },
  "4": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "{{checkpoint}}"}},
  "5": {"class_type": "EmptyLatentImage", "inputs": {"batch_size": 3, "width": 768, "height": 1024}},
  "6": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["4", 1], "text": "{{prompt}}"}},
  "7": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["4", 1], "text": "{{negative}}"}},
  "8": {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["4", 2]}},
  "9": {"class_type": "SaveImage", "inputs": {"filename_prefix": "hub-cover", "images": ["8", 0]}}
}
