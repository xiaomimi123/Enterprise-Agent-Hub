# 复制为 .env 后修改；或运行 `make env` 自动生成随机密码
# 密码只用字母和数字，避免在连接串里需要转义

TZ=Asia/Shanghai

# 中枢服务器在局域网里的地址（员工电脑访问用），例如 192.168.1.10
HUB_HOST=192.168.1.10

# ---- 版本（升级时只改这里）----
CASDOOR_VERSION=4.20.0
NEWAPI_VERSION=v0.13.2
RAGFLOW_VERSION=v0.27.2

# ---- 端口 ----
# 控制台（浏览器访问 http://HUB_HOST:CONSOLE_PORT）
CONSOLE_PORT=8088
# 中枢 MCP Server（员工端 agent 连接 http://HUB_HOST:MCP_PORT/mcp）
MCP_PORT=8200
CASDOOR_PORT=8000
NEWAPI_PORT=3000
# RAGFlow 网页端口，默认不用 80，给以后的统一入口留位置
RAGFLOW_WEB_PORT=8080
# RAGFlow API 端口（中枢 MCP Server 调它）
RAGFLOW_API_PORT=9380

# ---- 企业组织 ----
# 企业在 Casdoor 中的组织名（英文，钉钉组织同步到这里）和显示名
HUB_ORG=xinghe
HUB_ORG_DISPLAY=星河品牌（演示）

# ---- Casdoor ----
# 浏览器访问 Casdoor 的完整地址，钉钉登录回调会用到
CASDOOR_ORIGIN=http://192.168.1.10:8000
# built-in/admin 的初始密码（只在首次启动时生效）
CASDOOR_ADMIN_PASSWORD=change_me_casdooradmin

# ---- 共用 PostgreSQL / Redis ----
POSTGRES_PASSWORD=change_me_pg
CASDOOR_DB_PASSWORD=change_me_casdoor
NEWAPI_DB_PASSWORD=change_me_newapi
REDIS_PASSWORD=change_me_redis
# 中枢自研服务（控制台、MCP Server）的数据库：岗位包、成员分配、审计日志
HUB_DB_PASSWORD=change_me_hubdb
# PostgreSQL 映射到本机 127.0.0.1 的端口
POSTGRES_HOST_PORT=25432

# ---- New API ----
NEWAPI_SESSION_SECRET=change_me_session

# ---- RAGFlow（替换官方默认弱口令）----
RAGFLOW_ELASTIC_PASSWORD=change_me_es
RAGFLOW_MYSQL_PASSWORD=change_me_mysql
RAGFLOW_MINIO_PASSWORD=change_me_minio
RAGFLOW_REDIS_PASSWORD=change_me_ragredis
RAGFLOW_ADMIN_PASSWORD=change_me_admin

# ---- 由 make bootstrap 自动写入，无需手填 ----
# CASDOOR_CONSOLE_CLIENT_ID / CASDOOR_CONSOLE_CLIENT_SECRET：控制台登录
# HUB_AGENT_CLIENT_ID / HUB_AGENT_CLIENT_SECRET：员工端官方 agent
# HUB_EXTERNAL_CLIENT_ID / HUB_EXTERNAL_CLIENT_SECRET：外部智能体（MCP 接入）
